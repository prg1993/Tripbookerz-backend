# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git — add .env to .gitignore.

# Found in your MSG91 dashboard under account/API settings.
MSG91_AUTH_KEY=

# Created under MSG91 Dashboard -> OTP -> Templates.
# The template message must contain {{otp}} as a placeholder, e.g.:
# "Your Tripbookerz OTP is {{otp}}. Valid for 5 minutes. Do not share it."
MSG91_TEMPLATE_ID=

# Postgres connection string from Neon (or Supabase, or any Postgres host).
# Neon dashboard -> your project -> Connection Details -> copy the
# "psycopg2" / standard connection string. Looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# A long random secret string YOU generate (e.g. `openssl rand -hex 32`).
# Required by the admin-only endpoints (booking lookup, coupon/campaign
# management, changing platform markup). The Tripbookerz admin panel must
# send this back as the X-Admin-Key header. This is a stopgap for
# pre-prod — replace with real per-user accounts + roles before this
# handles real agents/admins with different permission levels.
ADMIN_API_KEY=

# "staging" (default) or "production". If set to "production":
#  - CORS_ORIGINS below becomes mandatory (app refuses to start without it)
#  - ALLOW_INMEMORY_RATE_LIMIT_IN_PROD must also be set to "true", or the
#    app refuses to start (the current rate limiter is single-instance only)
# Leave unset/at "staging" for pre-prod testing — both behaviors above
# relax to permissive staging defaults automatically.
DEPLOY_ENV=staging

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://www.tripbookerz.com,https://staging.tripbookerz.com
# Required when DEPLOY_ENV=production. Optional in staging — if set,
# staging honors it too (useful for testing the restricted behavior
# before actually flipping DEPLOY_ENV); if unset in staging, CORS
# defaults to allow-all for convenience.
CORS_ORIGINS=

# From resend.com dashboard -> API Keys. Permanent free tier: 3,000
# emails/month (unlike SendGrid, whose free tier is now a 60-day trial
# only — confirmed current as of building this integration).
# Which email provider to use — currently only "resend" is implemented,
# but this follows the exact same OTP_PROVIDER pattern (see above): every
# email send goes through send_email_via_provider(), never a specific
# provider's function directly, so adding a second provider later is
# one new adapter function + one line in _EMAIL_PROVIDERS, not a rewrite.
EMAIL_PROVIDER=resend

RESEND_API_KEY=

# Must be an address on a domain you've VERIFIED in Resend's dashboard
# (Resend -> Domains -> Add Domain -> add the DNS records they give you).
# Until that verification is done, Resend will only deliver from its own
# sandbox address (onboarding@resend.dev) — trying to send from
# no-reply@tripbookerz.com before the domain is verified will fail.
# Leave this as the default sandbox address until DNS verification is done.
EMAIL_FROM=onboarding@resend.dev

# Every business email address the backend uses is configurable, since
# addresses like this genuinely do change over time. This one address
# controls two things: it's the Reply-To on every confirmation email,
# AND the domain allowed for client-supplied CC addresses is derived
# from it automatically (e.g. support@tripbookerz.com -> only
# *@tripbookerz.com addresses are accepted as CC) — so changing this
# one value keeps both in sync, no separate domain setting needed.
SUPPORT_EMAIL=support@tripbookerz.com

# Which OTP/SMS provider to use — "msg91" (default) or "message_central".
# Switching providers is just this one line + that provider's credentials
# below; no code change needed, since every route calls a generic
# send_otp_via_provider()/verify_otp_via_provider() dispatcher, never a
# specific provider's function directly.
OTP_PROVIDER=msg91

# Only needed if OTP_PROVIDER=message_central. From
# console.messagecentral.com after signup (Dashboard shows your customerId).
# Chosen as an MSG91 alternative specifically because its pre-approved
# shared DLT route lets sending start immediately, without MSG91's
# multi-day DLT registration wait — confirmed current when this was built.
MC_CUSTOMER_ID=
MC_PASSWORD=
MC_EMAIL=
