# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git — add .env to .gitignore.

# Found in your MSG91 dashboard under account/API settings.
MSG91_AUTH_KEY=

# Created under MSG91 Dashboard -> OTP -> Templates.
# The template message must contain {{otp}} as a placeholder, e.g.:
# "Your Tripbookerz OTP is {{otp}}. Valid for 5 minutes. Do not share it."
MSG91_TEMPLATE_ID=

# Postgres connection string from Neon (or Supabase, or any Postgres host).
# Neon dashboard -> your project -> Connection Details -> copy the
# "psycopg2" / standard connection string. Looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# A long random secret string YOU generate (e.g. `openssl rand -hex 32`).
# Required by the admin-only endpoints (booking lookup, coupon/campaign
# management, changing platform markup). The Tripbookerz admin panel must
# send this back as the X-Admin-Key header. This is a stopgap for
# pre-prod — replace with real per-user accounts + roles before this
# handles real agents/admins with different permission levels.
ADMIN_API_KEY=
